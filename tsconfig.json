{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@digital-twin/components": [
        "src/shared/components/index.ts"
      ],
      "@digital-twin/icons": [
        "src/shared/assets/lib/icon/index.ts"
      ],
      "@digital-twin/images/*": [
        "src/shared/assets/lib/image/*"
      ],
      "@digital-twin/reusables": [
        "src/shared/ui/index.ts"
      ],
      "@digital-twin/reusables/*": [
        "src/shared/ui/*"
      ],
      "@digital-twin/utils": [
        "src/shared/utils/index.ts"
      ]
    }
  },
  "include": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.*"
  ]
}
