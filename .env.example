# Vite forwards API requests to the local backend during development and preview.
VITE_API_PROXY=https://localhost:4500
# Leave blank for same-origin requests.
VITE_API_URL=
VITE_ORG=local
VITE_PRJ=digital_twin_afdd
VITE_DB_BUSINESS=am
VITE_DB_MACHINE=amm
# Blank uses the backend MQTT WebSocket port on the browser's host.
# Docker builds use /mqtt, proxied by nginx on the UI's origin.
VITE_MQTT_URL=
VITE_MQTT_USERNAME=afdd_ui
VITE_MQTT_PASSWORD=indie123
VITE_MQTT_NOTIFICATION_TOPIC=AFDD_NOTIFICATION
# Standalone frontend container, when the backend runs on the Docker host:
BACKEND_UPSTREAM=https://host.docker.internal:4500
MQTT_UPSTREAM=https://host.docker.internal:9002
FRONTEND_PORT=8082
